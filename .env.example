# Z-TRUST Environment Variables
# Copy this file to .env and fill in your values.

# Required: Groq API key for LLM-powered verification
GROQ_API_KEY=PASTE_YOUR_KEY_HERE

# Model for claim verification (default: openai/gpt-oss-120b; also supported: qwen/qwen3.8-27b, openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# Model for web search evidence retrieval (default: openai/gpt-oss-120b; also supported: openai/gpt-oss-20b)
GROQ_SEARCH_MODEL=openai/gpt-oss-120b

# Optional: Alternative Search Provider configuration
# Choose from: 'groq' (default), 'tavily', 'serper', 'duckduckgo'
SEARCH_PROVIDER=groq
# If using Tavily search (https://tavily.com):
TAVILY_API_KEY=
# If using Serper Google search (https://serper.dev):
SERPER_API_KEY=

# Optional: API request timeout in seconds (default: 30)
GROQ_TIMEOUT=30

# Optional: Server host and port
HOST=127.0.0.1
PORT=8000
